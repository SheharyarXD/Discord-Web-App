# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# Initial administrator, consumed ONLY by `npm run db:seed`.
# Set the password via environment/CLI at seed time; do not store real passwords in git.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Session lifetime in days
SESSION_DAYS="14"

# Optional feature switches. Gems is hidden by default at the client's request;
# set to "true" to show the section again (its tables and data are kept either way).
FEATURE_GEMS="false"
