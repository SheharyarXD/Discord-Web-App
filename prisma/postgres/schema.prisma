  asset          SourceAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  section        String? // region/heading inside the asset
  field          String? // which attribute(s) of the target this evidence supports
  sourceText     String? // verbatim wording
  reviewStatus   String         @default("NEEDS_REVIEW") // CONFIRMED | PARTIALLY_CONFIRMED | NEEDS_REVIEW
  ambiguityNote  String?
  supersededById String?
