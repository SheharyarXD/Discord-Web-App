  roleId         String?
  role           NinjaRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  equipmentId    String?
  equipment      Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentSetId String?
  equipmentSet   EquipmentSet? @relation(fields: [equipmentSetId], references: [id], onDelete: SetNull)
  jewelryId      String?
  jewelry        Jewelry?      @relation(fields: [jewelryId], references: [id], onDelete: SetNull)
  jewelrySetId   String?
  jewelrySet     JewelrySet?   @relation(fields: [jewelrySetId], references: [id], onDelete: SetNull)
  gemId          String?
