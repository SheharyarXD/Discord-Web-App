/// Never fetched automatically: assets are registered by the operator-run loader only.
model SourceAsset {
  id            String         @id @default(cuid())
  path          String         @unique // path inside the read-only reference folder, or a message id
  category      String // SCREENSHOT | CLIENT_MESSAGE | DOCUMENT (see SOURCE_CATEGORIES)
  description   String?
  capturedAt    DateTime? // only when genuinely known; NOT the game release date
  capturedNote  String?
  reviewed      Boolean        @default(false)
  fullyLegible  Boolean?
  duplicateOfId String?
  duplicateOf   SourceAsset?   @relation("AssetDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    SourceAsset[]  @relation("AssetDuplicate")
