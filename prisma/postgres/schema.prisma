  supersedes     SourceRecord[] @relation("RecordSupersession")

  // targets (at most one is set)
  ninjaId        String?
  ninja          Ninja?        @relation(fields: [ninjaId], references: [id], onDelete: SetNull)
  abilityId      String?
  ability        Ability?      @relation(fields: [abilityId], references: [id], onDelete: SetNull)
  talentOptionId String?
  talentOption   TalentOption? @relation(fields: [talentOptionId], references: [id], onDelete: SetNull)
  statusEffectId String?
  statusEffect   StatusEffect? @relation(fields: [statusEffectId], references: [id], onDelete: SetNull)
  effectId       String?
  effect         Effect?       @relation(fields: [effectId], references: [id], onDelete: SetNull)
  statisticId    String?
  statistic      Statistic?    @relation(fields: [statisticId], references: [id], onDelete: SetNull)
  formationId    String?
