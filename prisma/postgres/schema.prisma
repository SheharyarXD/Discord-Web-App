  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([reviewStatus])
  @@index([ninjaId])
  @@index([statusEffectId])
  @@index([effectId])
  @@index([abilityId])
  @@index([equipmentId])
  @@index([equipmentSetId])
  @@index([jewelryId])
  @@index([jewelrySetId])
}

// ───────────────────────── Vocabularies ─────────────────────────

/// Statistic definitions (HP, Force, Chakra, Attack...). Rows are data, not code.
/// `name` is the source wording; never sort or compare values of different `valueType`s together.
model Statistic {
  id                String                 @id @default(cuid())
  key               String                 @unique
  name              String
  nameEs            String?
  translationStatus String                 @default("MISSING") // MISSING | DRAFT | VERIFIED
  description       String?
  category          String? // free grouping label for later filters (e.g. "base", "combat")
  defaultValueType  String                 @default("FLAT") // FLAT | PERCENT | MULTIPLIER (see VALUE_TYPES)
  reviewStatus      String                 @default("CONFIRMED")
  note              String?
  sortOrder         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  effects           Effect[]
  aliases           StatisticAlias[]
  baseStats         NinjaBaseStat[]
  statusModifiers   StatusEffectModifier[]
  primaryFor        Formation[]
  sourceRecords     SourceRecord[]

  @@index([category])
}

model StatisticAlias {
  id          String    @id @default(cuid())
  statisticId String
  statistic   Statistic @relation(fields: [statisticId], references: [id], onDelete: Cascade)
  alias       String
  normalized  String // lower-cased, accent-free form used for lookups
  locale      String    @default("en")

  @@unique([statisticId, normalized])
  @@index([normalized])
}

/// M1 "role". Since M2 this is the SOURCE CATEGORY a ninja is filed under (the reference forum's
/// `supporters` / `assaulters` / `vanguards`). It is NOT the in-game formation: a role only
/// resolves to a formation through an APPROVED mapping.
model NinjaRole {
  id                 String         @id @default(cuid())
  key                String         @unique
  name               String
  nameEs             String?
  description        String?
  sortOrder          Int            @default(0)
  mappedFormationId  String?
  mappedFormation    Formation?     @relation(fields: [mappedFormationId], references: [id], onDelete: SetNull)
  mappingStatus      String         @default("UNMAPPED") // UNMAPPED | PROPOSED | APPROVED
  mappingNote        String?
  ninjas             Ninja[]
  targetedConditions Condition[]
  sourceRecords      SourceRecord[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

/// In-game formation position (support = rear, center = middle, vanguard = front).
/// Independent from the client's Tank/DPS label and from the source category.
model Formation {
  id                 String         @id @default(cuid())
  key                String         @unique
  name               String // source (English) label as printed on ninja cards
  nameEs             String?
  translationStatus  String         @default("MISSING")
  positionNote       String? // e.g. "rear" — descriptive only
  /// Client-confirmed rule: the stat this position primarily fights with. Derived semantics only;
  /// every stat printed on a card is still stored in NinjaBaseStat.
  primaryStatisticId String?
  primaryStatistic   Statistic?     @relation(fields: [primaryStatisticId], references: [id], onDelete: SetNull)
  /// Client-stated team limit, kept as reference data for a future feature. Nothing enforces it.
  maxPerTeam         Int?
  /// Another row that may be the SAME position under a different name (the card prints
  /// "Assaulter", the client says "Center"). Only an APPROVED equivalence is ever acted on.
  equivalentToId     String?
  equivalentTo       Formation?     @relation("FormationEquivalence", fields: [equivalentToId], references: [id], onDelete: SetNull)
  equivalents        Formation[]    @relation("FormationEquivalence")
  equivalenceStatus  String         @default("NONE") // NONE | PROPOSED | APPROVED
  equivalenceNote    String?
  sortOrder          Int            @default(0)
  ninjas             Ninja[]
  mappedRoles        NinjaRole[]
  targetedConditions Condition[]
  sourceRecords      SourceRecord[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

/// Rating vocabulary (S, SS, SSS, SR, SSR, ...). `sortOrder` is a display order only — it does
/// not assert a power ranking, and alphabetical order must never be used as one.
model NinjaRating {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int      @default(0)
  ninjas    Ninja[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// In-game ninja type (e.g. "Genjutsu"). Independent from rating and formation.
model NinjaType {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  nameEs            String?
  translationStatus String   @default("MISSING")
  sortOrder         Int      @default(0)
  ninjas            Ninja[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AbilityType {
  id        String    @id @default(cuid())
  key       String    @unique // e.g. skill, passive, awakening, attack — rows, not code
  name      String
  sortOrder Int       @default(0)
  abilities Ability[]
}

model EffectTarget {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. self, ally, enemy
  name      String
  sortOrder Int      @default(0)
  effects   Effect[]
}

/// Kinds of condition: nature, role, formation, ninja, gender, element, trigger, status...
model ConditionType {
  id         String           @id @default(cuid())
  key        String           @unique
  name       String
  sortOrder  Int              @default(0)
  values     ConditionValue[]
  conditions Condition[]
}

/// Catalogue of values a condition type can reference (e.g. type "nature" → one nature).
/// The values of type "nature" double as the catalogue of ninja natures (see NinjaNature).
model ConditionValue {
  id              String        @id @default(cuid())
  conditionTypeId String
  conditionType   ConditionType @relation(fields: [conditionTypeId], references: [id], onDelete: Cascade)
  key             String
  name            String
  nameEs          String?
  sortOrder       Int           @default(0)
  conditions      Condition[]
  ninjaNatures    NinjaNature[]

  @@unique([conditionTypeId, key])
}

// ───────────────────────── Status / effect dictionary ─────────────────────────

/// Reusable definition of a named state (Shatter Storm, Poison, Blind...). Classification is
/// multidimensional: polarity, cleansability and categories are independent facets.
/// `description` is the verbatim guide wording — reference text, not an executable formula.
model StatusEffect {
  id                 String                 @id @default(cuid())
  key                String                 @unique
  /// STATUS = a state applied to a ninja; TERM = a mechanic defined by the guide (Pierce, DoT...).
  kind               String                 @default("STATUS")
  name               String // primary source name
  nameEs             String?
  description        String? // verbatim source definition
  descriptionEs      String?
  translationStatus  String                 @default("MISSING")
  polarity           String                 @default("UNKNOWN") // BUFF | DEBUFF | NEUTRAL | UNKNOWN
  cleansability      String                 @default("UNKNOWN") // CLEANSABLE | UNCLEANSABLE | CONDITIONAL | UNKNOWN
  cleansabilityNote  String? // exceptions, verbatim where possible
  /// true when the source says the default magnitude holds "unless other is stated".
  overrideDocumented Boolean                @default(false)
  timingNote         String? // e.g. "at the start of your turn"
  note               String?
  structuredStatus   String                 @default("STRUCTURED") // STRUCTURED | TEXT_ONLY | NEEDS_REVIEW
  reviewStatus       String                 @default("NEEDS_REVIEW")
  sortOrder          Int                    @default(0)
  aliases            StatusEffectAlias[]
  categories         StatusEffectCategory[]
  modifiers          StatusEffectModifier[]
  usages             Effect[]
  sourceRecords      SourceRecord[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([kind])
  @@index([polarity])
  @@index([cleansability])
}

/// Alternative names. NOT globally unique on purpose: the guide uses "Shielding state" both as
/// an alias of another entry and as its own entry, and both readings must survive.
model StatusEffectAlias {
  id             String       @id @default(cuid())
  statusEffectId String
  statusEffect   StatusEffect @relation(fields: [statusEffectId], references: [id], onDelete: Cascade)
  alias          String
  normalized     String
  locale         String       @default("en")

  @@unique([statusEffectId, normalized])
  @@index([normalized])
}

/// Category facet (dot, cc, stat_modifier, immunity, shield...). A status may have several.
model StatusCategory {
  id        String                 @id @default(cuid())
  key       String                 @unique
  name      String
  nameEs    String?
  sortOrder Int                    @default(0)
  statuses  StatusEffectCategory[]
}

model StatusEffectCategory {
  statusEffectId String
  statusEffect   StatusEffect   @relation(fields: [statusEffectId], references: [id], onDelete: Cascade)
  categoryId     String
  category       StatusCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([statusEffectId, categoryId])
  @@index([categoryId])
}

/// Default component of a status: "attack +15%", "defenses +15%". `statLabel` keeps the source
/// wording; `statisticId` links it to the dictionary only when that is unambiguous.
/// A usage-level override replaces the magnitude of every component with `overridable = true`.
model StatusEffectModifier {
  id             String       @id @default(cuid())
  statusEffectId String
  statusEffect   StatusEffect @relation(fields: [statusEffectId], references: [id], onDelete: Cascade)
  statLabel      String
  statisticId    String?
  statistic      Statistic?   @relation(fields: [statisticId], references: [id], onDelete: Restrict)
  direction      String       @default("INCREASE") // INCREASE | DECREASE
  magnitude      Decimal? // null = the source gives no number
  valueType      String       @default("PERCENT")
  overridable    Boolean      @default(true)
  note           String?
  sortOrder      Int          @default(0)

  @@index([statusEffectId])
  @@index([statisticId])
}

// ───────────────────────── Effect usages & conditions ─────────────────────────

/// A single mechanical effect IN CONTEXT (an "effect usage"). Owned by exactly ONE of the owner
/// columns (trigger-enforced). It is either a direct stat modifier (`statisticId` + `value`),
/// the application of a dictionary status (`statusEffectId` [+ `magnitudeOverride`]), or text.
///
///   value / magnitudeOverride → POWER          chancePercent → PROBABILITY (null = not stated)
///   durationTurns             → DURATION       targetId + TARGET-scope conditions → WHO
model Effect {
  id                String        @id @default(cuid())
  statisticId       String?
  statistic         Statistic?    @relation(fields: [statisticId], references: [id], onDelete: Restrict)
  value             Decimal?
  valueType         String        @default("FLAT") // FLAT | PERCENT | MULTIPLIER
  statusEffectId    String?
  statusEffect      StatusEffect? @relation(fields: [statusEffectId], references: [id], onDelete: Restrict)
  /// Replaces the default magnitude of the status' overridable components FOR THIS USAGE ONLY.
  /// It is the "(20%)" in "enter (20%) shatter storm state" — a strength, never a chance.
  magnitudeOverride Decimal?
  targetId          String?
  target            EffectTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetText        String? // original target wording, e.g. "ally assaulters"
  durationTurns     Int? // rounds
  chancePercent     Decimal? // 0–100; null = no chance stated (NOT "always" and NOT the magnitude)
  /// What the row is: ATTACK | STAT | STATUS | IMMUNITY | FURY | HEAL | DISPEL | TEXT (see EFFECT_KINDS).
  kind              String        @default("STAT")
  /// A "rate" the source states. It is NEVER a probability unless rateKind says APPLICATION:
  ///   GROWTH "attacks with 300% growth rate" · INTENSITY "poisons with 120% rate", "heals with 50% rate"
  ///   APPLICATION "80% rate to stun" (kept apart from chancePercent, which needs the word "chance")
  rateValue         Decimal?
  rateKind          String?
  /// Value an awakening line says it replaces ("from 83% → 86%": value 86, replacesValue 83).
  replacesValue     Decimal?
  /// Qualitative wording when the source gives no number ("high rate", "a certain percentage"),
  /// or a rider on the number ("can exceed cap").
  valueNote         String?
  targetCount       Int? // "2 random allies" → 2
  targetSelector    String? // RANDOM | HIGHEST_HP | LOWEST_HP | ... (see TARGET_SELECTORS)
  excludesSelf      Boolean       @default(false)
  /// Alternatives inside one ability: rows sharing a choiceGroup are options of which ONE
  /// applies ("Deva Path … OR Animal Path …"). Different groups are independent of each other.
  choiceGroup       Int?
  choiceLabel       String?
  /// Position of the source line inside its ability; rows parsed from one line share it.
  sourceLine        Int?
  note              String?
  triggerText       String? // original trigger wording, if any
  conditionText     String? // natural-language requirement not (yet) structured → still conditional
  structuredStatus  String        @default("STRUCTURED") // STRUCTURED | NEEDS_REVIEW | TEXT_ONLY
  sourceText        String? // verbatim wording of this usage
  description       String? // free text when an effect is not purely numeric
  descriptionEs     String?
  translationStatus String        @default("MISSING")
  sortOrder         Int           @default(0)

  // owners (exactly one is set)
  abilityId           String?
  ability             Ability?           @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  talentOptionId      String?
  talentOption        TalentOption?      @relation(fields: [talentOptionId], references: [id], onDelete: Cascade)
  equipmentId         String?
  equipment           Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentSetBonusId String?
  equipmentSetBonus   EquipmentSetBonus? @relation(fields: [equipmentSetBonusId], references: [id], onDelete: Cascade)
  jewelryId           String?
  jewelry             Jewelry?           @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  jewelrySetBonusId   String?
  jewelrySetBonus     JewelrySetBonus?   @relation(fields: [jewelrySetBonusId], references: [id], onDelete: Cascade)
  gemId               String?
  gem                 Gem?               @relation(fields: [gemId], references: [id], onDelete: Cascade)

  conditions    Condition[]
  sourceRecords SourceRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([abilityId])
  @@index([talentOptionId])
  @@index([equipmentId])
  @@index([equipmentSetBonusId])
  @@index([jewelryId])
  @@index([jewelrySetBonusId])
  @@index([gemId])
  @@index([statisticId, valueType, value])
  @@index([statusEffectId])
  @@index([kind])
}

/// A requirement/restriction attached to an effect usage.
///   scope ACTIVATION → precondition for the effect to apply at all
///   scope TARGET     → narrows WHO receives it (e.g. only allies filed as "assaulters")
/// Conditions sharing an `alternativeGroup` are ANDed; different groups are ORed;
/// operator EXCLUDES negates one — together that expresses any AND/OR/NOT combination.
model Condition {
  id               String          @id @default(cuid())
  effectId         String
  effect           Effect          @relation(fields: [effectId], references: [id], onDelete: Cascade)
  scope            String          @default("ACTIVATION") // ACTIVATION | TARGET
  conditionTypeId  String
  conditionType    ConditionType   @relation(fields: [conditionTypeId], references: [id], onDelete: Restrict)
  conditionValueId String?
  conditionValue   ConditionValue? @relation(fields: [conditionValueId], references: [id], onDelete: Restrict)
  // direct references for subjects that are entities of their own
  ninjaId          String?
  ninja            Ninja?          @relation("ConditionSubjectNinja", fields: [ninjaId], references: [id], onDelete: Restrict)
  formationId      String?
  formation        Formation?      @relation(fields: [formationId], references: [id], onDelete: Restrict)
  roleId           String?
  role             NinjaRole?      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  operator         String          @default("REQUIRES") // REQUIRES | EXCLUDES
  numericValue     Decimal? // thresholds ("HP below 30")
  note             String? // free-text qualifier
  sourceText       String?
  alternativeGroup Int             @default(0)
  sortOrder        Int             @default(0)

  @@index([effectId])
  @@index([conditionTypeId, conditionValueId])
  @@index([ninjaId])
  @@index([formationId])
  @@index([roleId])
}

// ───────────────────────── Ninjas ─────────────────────────

/// One named release/variant = one row ("Uchiha Madara" and "Uchiha Madara (Moon's Eye)" are two).
model Ninja {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String // original source name, exactly as written
  nameEs              String?
  description         String? // source text
  descriptionEs       String?
  translationStatus   String          @default("MISSING")
  imageUrl            String?
  /// Source category (reference forum label). See NinjaRole.
  roleId              String?
  role                NinjaRole?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// In-game formation, set only from direct evidence or an APPROVED role mapping.
  formationId         String?
  formation           Formation?      @relation(fields: [formationId], references: [id], onDelete: SetNull)
  ratingId            String?
  rating              NinjaRating?    @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  ninjaTypeId         String?
  ninjaType           NinjaType?      @relation(fields: [ninjaTypeId], references: [id], onDelete: SetNull)
  /// Client-assigned label, NOT game data: TANK | DPS | null (unassigned). One column, so a
  /// ninja can never be both. Never inferred from stats.
  clientCombatClass   String?
  /// Release period with MONTH granularity; no day is ever stored.
  releaseYear         Int?
  releaseMonth        Int? // 1–12
  /// Position in the source release list (ascending = older). Tie-breaker within a month.
  releaseOrder        Int?
  status              String          @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED (see CONTENT_STATUSES)
  reviewStatus        String          @default("NEEDS_REVIEW")
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  abilities           Ability[]
  talentGroups        TalentGroup[]
  baseStats           NinjaBaseStat[]
  natures             NinjaNature[]
  subjectOfConditions Condition[]     @relation("ConditionSubjectNinja")
  sourceRecords       SourceRecord[]
  aliases             NinjaAlias[]

  @@index([roleId])
  @@index([status])
  @@index([formationId])
  @@index([ratingId])
  @@index([ninjaTypeId])
  @@index([clientCombatClass])
  @@index([releaseYear, releaseMonth, releaseOrder])
  @@index([name])
}

/// Another name the same ninja goes by: the card name plate, the thread title, a spelling variant.
/// The canonical `Ninja.name` is never rewritten from an alias.
model NinjaAlias {
  id         String   @id @default(cuid())
  ninjaId    String
  ninja      Ninja    @relation(fields: [ninjaId], references: [id], onDelete: Cascade)
  alias      String
  normalized String
  kind       String // CARD_NAME | SOURCE_NAME (see ALIAS_KINDS)
  locale     String   @default("en")
  /// VERIFIED same words, mechanically · REVIEWED a judgement backed by `note`, awaiting the client
  status     String   @default("REVIEWED")
  note       String?
  createdAt  DateTime @default(now())

  @@unique([ninjaId, normalized, kind])
  @@index([normalized])
}

/// A base attribute printed on the ninja card, with its growth rate. One row per statistic.
/// `growthRate` is its own number: it is not a percentage bonus and not a set bonus.
model NinjaBaseStat {
  id          String    @id @default(cuid())
  ninjaId     String
  ninja       Ninja     @relation(fields: [ninjaId], references: [id], onDelete: Cascade)
  statisticId String
  statistic   Statistic @relation(fields: [statisticId], references: [id], onDelete: Restrict)
  sourceLabel String // label as printed on the card
  baseValue   Decimal
  growthRate  Decimal?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ninjaId, statisticId])
  @@index([statisticId, baseValue])
  @@index([statisticId, growthRate])
}

/// Elemental nature(s) of a ninja. Optional: older ninjas have none.
/// `natureId` must be a ConditionValue of type "nature" (trigger-enforced).
model NinjaNature {
  ninjaId  String
  ninja    Ninja          @relation(fields: [ninjaId], references: [id], onDelete: Cascade)
  natureId String
  nature   ConditionValue @relation(fields: [natureId], references: [id], onDelete: Restrict)

  @@id([ninjaId, natureId])
  @@index([natureId])
}

/// Skills, passives, awakenings, attacks... distinguished by AbilityType rows. All optional.
model Ability {
  id                String         @id @default(cuid())
  ninjaId           String
  ninja             Ninja          @relation(fields: [ninjaId], references: [id], onDelete: Cascade)
  abilityTypeId     String
  abilityType       AbilityType    @relation(fields: [abilityTypeId], references: [id], onDelete: Restrict)
  name              String
  nameEs            String?
  description       String? // original text
  descriptionEs     String?
  translationStatus String         @default("MISSING")
  triggerText       String?
  stage             Int? // rank / awakening stage, when the source gives one
  /// Name printed on the ninja card (may be cut off by the game UI). `name` is the heading
  /// used in the ability text; both are kept when they differ.
  cardLabel         String?
  cardLabelCut      Boolean        @default(false)
  /// Heading exactly as posted in the source ("Talent Awakening 1: Sage Mode").
  sourceHeading     String?
  /// An awakening belongs to the skill it awakens (parentAbilityId) OR to a talent
  /// (talentOptionId) — never both (trigger-enforced).
  parentAbilityId   String?
  parentAbility     Ability?       @relation("AbilityAwakenings", fields: [parentAbilityId], references: [id], onDelete: Cascade)
  awakenings        Ability[]      @relation("AbilityAwakenings")
  talentOptionId    String?
  talentOption      TalentOption?  @relation(fields: [talentOptionId], references: [id], onDelete: Cascade)
  /// How this awakening combines with what came before. Set ONLY from explicit source wording:
  ///   NOT_APPLICABLE base ability · UNKNOWN the source does not say · CUMULATIVE adds to prior
  ///   REPLACES_PRIOR its effects replace an earlier stage · CANCELS_PRIOR switches an earlier stage off
  ///   UPGRADES_BASE restates specific base numbers ("from 83% → 86%")
  /// No code may sum stages while the rule is UNKNOWN.
  stackingRule      String         @default("NOT_APPLICABLE")
  supersedesId      String?
  supersedes        Ability?       @relation("AbilitySupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy      Ability[]      @relation("AbilitySupersession")
  ruleSourceText    String? // verbatim wording the rule rests on
  conditionText     String? // e.g. "Special Jugo Card Awakening"
  note              String?
  imageUrl          String?
  reviewStatus      String         @default("NEEDS_REVIEW")
  sortOrder         Int            @default(0)
  effects           Effect[]
  sourceRecords     SourceRecord[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ninjaId])
  @@index([abilityTypeId])
  @@index([parentAbilityId])
  @@index([talentOptionId])
}

/// A set of talent choices. "Choose ONE of A/B" is a group with selectionMode ONE_OF
/// and two options — never two independent talents.
model TalentGroup {
  id            String         @id @default(cuid())
  ninjaId       String
  ninja         Ninja          @relation(fields: [ninjaId], references: [id], onDelete: Cascade)
  name          String?
  selectionMode String         @default("ONE_OF") // ONE_OF | ALL (see SELECTION_MODES)
  minSelections Int            @default(1)
  maxSelections Int            @default(1)
  reviewStatus  String         @default("NEEDS_REVIEW") // unknown/contradictory rules stay pending
  note          String?
  sortOrder     Int            @default(0)
  options       TalentOption[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ninjaId])
}

model TalentOption {
  id                String                @id @default(cuid())
  groupId           String
  group             TalentGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name              String
  nameEs            String?
  description       String?
  descriptionEs     String?
  translationStatus String                @default("MISSING")
  imageUrl          String?
  /// M1 column, kept for compatibility. Since M2 it is NOT rendered as a selection: which
  /// option is active is a per-user choice (UserTalentSelection), never canonical game data.
  isDefault         Boolean               @default(false)
  cardLabel         String?
  cardLabelCut      Boolean               @default(false)
  sourceHeading     String?
  note              String?
  reviewStatus      String                @default("NEEDS_REVIEW")
  sortOrder         Int                   @default(0)
  effects           Effect[]
  awakenings        Ability[]
  selections        UserTalentSelection[]
  sourceRecords     SourceRecord[]

  @@index([groupId])
}

/// A user's own pick inside a talent group. The number of picks per (user, group) can never
/// exceed what the group allows (trigger-enforced): at most ONE for a ONE_OF group.
model UserTalentSelection {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  option    TalentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, optionId])
  @@index([optionId])
}

// ───────────────────────── Equipment ─────────────────────────

model EquipmentSlot {
  id        String      @id @default(cuid())
  key       String      @unique
  name      String
  nameEs    String?
  sortOrder Int         @default(0)
  items     Equipment[]
}

model EquipmentSet {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  nameEs            String?
  description       String?
  descriptionEs     String?
  translationStatus String              @default("MISSING")
  imageUrl          String?
  /// Whether a higher tier ADDS to or REPLACES the lower ones. UNKNOWN until the client confirms;
  /// while UNKNOWN no code may compute a total across tiers.
  tierStacking      String              @default("UNKNOWN") // UNKNOWN | CUMULATIVE | REPLACES
  reviewStatus      String              @default("NEEDS_REVIEW")
  metadata          Json?
  items             Equipment[]
  bonuses           EquipmentSetBonus[]
  sourceRecords     SourceRecord[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

/// Bonus unlocked at ANY piece count — 2/4/6 are data, not schema.
model EquipmentSetBonus {
  id             String       @id @default(cuid())
  setId          String
  set            EquipmentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  requiredPieces Int
  description    String?
  descriptionEs  String?
  sortOrder      Int          @default(0)
  effects        Effect[]

  @@unique([setId, requiredPieces])
}

model Equipment {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  nameEs            String?
  description       String?
  descriptionEs     String?
  translationStatus String         @default("MISSING")
  slotId            String?
  slot              EquipmentSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  setId             String?
  set               EquipmentSet?  @relation(fields: [setId], references: [id], onDelete: SetNull)
  imageUrl          String?
  metadata          Json?
  status            String         @default("DRAFT")
  reviewStatus      String         @default("NEEDS_REVIEW")
  effects           Effect[] // the piece's OWN statistics/effects (set tiers live on the bonus)
  sourceRecords     SourceRecord[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([slotId])
  @@index([setId])
  @@index([status])
  @@index([name])
}

// ───────────────────────── Jewelry / accessories ─────────────────────────
// Deliberately NOT sharing tables with equipment: jewelry sets use different bonus rules
// (paired sub-groups with a 2-piece effect, a full-set tier, or specific named items).

model JewelryType {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  nameEs    String?
  sortOrder Int       @default(0)
  items     Jewelry[]
}

model JewelrySet {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  nameEs            String?
  description       String?
  descriptionEs     String?
  translationStatus String            @default("MISSING")
  imageUrl          String?
  /// Whether the source shows ONE set with sub-groups or several sets is not always established.
  structureStatus   String            @default("UNCONFIRMED") // UNCONFIRMED | CONFIRMED
  tierStacking      String            @default("UNKNOWN")
  reviewStatus      String            @default("NEEDS_REVIEW")
  metadata          Json?
  items             Jewelry[]
  groups            JewelryGroup[]
  bonuses           JewelrySetBonus[]
  sourceRecords     SourceRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// Sub-group of a jewelry set (e.g. a pair of pieces sharing a 2-piece effect).
model JewelryGroup {
  id        String            @id @default(cuid())
  setId     String
  set       JewelrySet        @relation(fields: [setId], references: [id], onDelete: Cascade)
  key       String
  name      String
  nameEs    String?
  sortOrder Int               @default(0)
  items     Jewelry[]
  bonuses   JewelrySetBonus[]

  @@unique([setId, key])
}

/// requirementKind PIECE_COUNT    → needs `requiredPieces` pieces; of `group` when groupId is
///                                  set (per-group 2-piece effect), otherwise of the whole set
///                                  (e.g. the 8-piece full-set tier).
/// requirementKind SPECIFIC_ITEMS → needs every item listed in `requiredItems`.
model JewelrySetBonus {
  id              String                @id @default(cuid())
  setId           String
  set             JewelrySet            @relation(fields: [setId], references: [id], onDelete: Cascade)
  groupId         String?
  group           JewelryGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requirementKind String                @default("PIECE_COUNT")
  requiredPieces  Int?
  description     String?
  descriptionEs   String?
  sortOrder       Int                   @default(0)
  requiredItems   JewelrySetBonusItem[]
  effects         Effect[]

  @@index([setId])
  @@index([groupId])
}

model JewelrySetBonusItem {
  bonusId   String
  bonus     JewelrySetBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  jewelryId String
  jewelry   Jewelry         @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  @@id([bonusId, jewelryId])
}

model Jewelry {
  id                String                @id @default(cuid())
  slug              String                @unique
  name              String
  nameEs            String?
  description       String?
  descriptionEs     String?
  translationStatus String                @default("MISSING")
  typeId            String?
  type              JewelryType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  setId             String?
  set               JewelrySet?           @relation(fields: [setId], references: [id], onDelete: SetNull)
  groupId           String?
  group             JewelryGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  imageUrl          String?
  metadata          Json?
  status            String                @default("DRAFT")
  reviewStatus      String                @default("NEEDS_REVIEW")
  effects           Effect[]
  bonusRequirements JewelrySetBonusItem[]
  sourceRecords     SourceRecord[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([typeId])
  @@index([setId])
  @@index([groupId])
  @@index([status])
  @@index([name])
}

// ───────────────────────── Gems ─────────────────────────
// Kept for future reactivation. The Gems section is hidden in the UI (see src/config/features.ts).

model GemType {
  id        String @id @default(cuid())
  key       String @unique
  name      String
  sortOrder Int    @default(0)
  gems      Gem[]
}

model Gem {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  gemTypeId     String?
  gemType       GemType?       @relation(fields: [gemTypeId], references: [id], onDelete: SetNull)
  level         Int?
  description   String?
  imageUrl      String?
  metadata      Json?
  status        String         @default("DRAFT")
  effects       Effect[]
  sourceRecords SourceRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([gemTypeId])
}
